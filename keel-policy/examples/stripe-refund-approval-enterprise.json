{
  "name": "Stripe refunds with admin approval above $100 (Enterprise)",
  "rules": [
    {
      "if": {
        "all": [
          {
            "field": "context._keel.action_envelope.connector.identity.value",
            "op": "eq",
            "value": "stripe"
          },
          {
            "field": "context._keel.action_envelope.connector.tool_name.value",
            "op": "eq",
            "value": "delete_customer"
          }
        ]
      },
      "action": "deny"
    },
    {
      "if": {
        "all": [
          {
            "field": "context._keel.action_envelope.connector.identity.value",
            "op": "eq",
            "value": "stripe"
          },
          {
            "field": "context._keel.action_envelope.connector.tool_name.value",
            "op": "in",
            "value": [
              "create_refund",
              "refund_payment"
            ]
          },
          {
            "field": "context._keel.action_envelope.financial.amount_usd_micros.state",
            "op": "in",
            "value": [
              "absent",
              "unknown",
              "not_applicable"
            ]
          }
        ]
      },
      "action": "require_human_review",
      "approval_requirement": {
        "type": "org_role",
        "role": "admin",
        "timeout_seconds": 3600
      }
    },
    {
      "if": {
        "all": [
          {
            "field": "context._keel.action_envelope.connector.identity.value",
            "op": "eq",
            "value": "stripe"
          },
          {
            "field": "context._keel.action_envelope.connector.tool_name.value",
            "op": "in",
            "value": [
              "create_refund",
              "refund_payment"
            ]
          },
          {
            "field": "context._keel.action_envelope.financial.amount_usd_micros.state",
            "op": "eq",
            "value": "present"
          },
          {
            "field": "context._keel.action_envelope.financial.amount_usd_micros.value",
            "op": "gt",
            "value": 100000000
          }
        ]
      },
      "action": "require_human_review",
      "approval_requirement": {
        "type": "org_role",
        "role": "admin",
        "timeout_seconds": 3600
      }
    },
    {
      "if": {
        "all": [
          {
            "field": "context._keel.action_envelope.connector.identity.value",
            "op": "eq",
            "value": "stripe"
          },
          {
            "field": "context._keel.action_envelope.connector.tool_name.value",
            "op": "in",
            "value": [
              "create_refund",
              "refund_payment"
            ]
          },
          {
            "field": "context._keel.action_envelope.financial.amount_usd_micros.state",
            "op": "eq",
            "value": "present"
          },
          {
            "field": "context._keel.action_envelope.financial.amount_usd_micros.value",
            "op": "lte",
            "value": 100000000
          }
        ]
      },
      "action": "allow"
    }
  ]
}
